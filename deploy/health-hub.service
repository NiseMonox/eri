[Unit]
Description=health-hub (FastAPI + APScheduler)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/projects/health-hub
Environment=TZ=Asia/Tokyo
# 本机专用的启动检查(比如确认直通进来的声卡型号)放 deploy/local/health-hub.service.d/*.conf,
# 不进仓库;make deploy 会一起装到 /etc/systemd/system/health-hub.service.d/
# 宿主机重启后混音器回默认静音;宿主机不装 alsa-utils,由本服务自己保证(- 前缀:失败不挡启动)
# 混音器固定 0dB(100%=不衰减,非增益),日常音量用 mpv 软件音量(schedule payload 的 volume)调
ExecStartPre=-/usr/bin/amixer -c1 -q sset Master 100% unmute
ExecStartPre=-/usr/bin/amixer -c1 -q sset Headphone 100% unmute
SupplementaryGroups=audio
ExecStart=/projects/health-hub/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8300 --no-access-log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
