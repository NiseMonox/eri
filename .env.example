# 复制为 .env 后填写。人手签发、基本不变的凭据放这里;运行时可变参数在网页 /settings 改(存 DB)。
API_TOKEN=change-me

# Bark(自建 bark-server,见 deploy/notes.md;device_key 在 iPhone Bark App 添加服务器后获得)
BARK_URL=http://127.0.0.1:8380
BARK_DEVICE_KEY=

# Telegram(Phase 2;@BotFather 建 bot 拿 token,chat_id 用 @userinfobot 查)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM:DeepSeek(platform.deepseek.com 取 key;模型在网页 /settings 的 llm.model 改,默认 deepseek-flash)
# 留空 = LLM 相关功能全部降级,正则快路径与提醒推送照常
DEEPSEEK_API_KEY=

# Withings(Phase 4;developer.withings.com 建应用)
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
# Withings 后台注册的回调 URL(要求公网 https;留空则用 BASE_URL 推导——私网地址多半被平台拒,
# 届时授权后从浏览器地址栏复制 code,走 POST /api/withings/exchange 手动完成)
WITHINGS_REDIRECT_URI=

# 服务(监听端口在 deploy/health-hub.service 与 Makefile 里,默认 8300;改了要同步改 BASE_URL)
BASE_URL=http://<server>:8300
DB_PATH=/projects/health-hub/data/healthhub.db
MEDIA_DIR=/projects/health-hub/media
